# Copy to backend/.env and fill in. NEVER commit the real .env file.

ENVIRONMENT=development            # development | production
# Local development (SQLite). Fine for learning; NOT equivalent to SQL Server.
DATABASE_URL=sqlite:///./eventvault.db
# Azure SQL (final target) - example format, replace the placeholders:
# DATABASE_URL=mssql+pyodbc://<USER>:<PASSWORD>@<SERVER>.database.windows.net:1433/<DATABASE>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of exact frontend origins allowed to call the API (no "*")
CORS_ORIGINS=http://localhost:5173

# File storage: "local" (saves to UPLOAD_DIR) or "azure" (Azure Blob Storage)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# Only needed when STORAGE_BACKEND=azure:
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=event-posters
